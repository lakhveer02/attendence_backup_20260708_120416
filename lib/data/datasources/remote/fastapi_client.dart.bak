import 'dart:io';
import 'package:dio/dio.dart';
import 'package:retrofit/retrofit.dart';

part 'fastapi_client.g.dart';

/// FastAPI client for AI/ML and device security operations
@RestApi()
abstract class FastApiClient {
  factory FastApiClient(Dio dio, {String baseUrl}) = _FastApiClient;

  /// Face Verification Endpoints
  
  @POST('/attendance/verify-face')
  @MultiPart()
  Future<FaceVerificationResponse> verifyFace(
    @Part(name: 'profile_id') String profileId,
    @Part(name: 'selfie') File selfie,
  );

  @POST('/faces/upload-reference')
  @MultiPart()
  Future<void> uploadReferenceFace(
    @Part(name: 'profile_id') String profileId,
    @Part(name: 'image') File image,
  );

  @POST('/faces/detect-liveness')
  @MultiPart()
  Future<LivenessResponse> detectLiveness(
    @Part(name: 'image') File image,
  );

  @PUT('/faces/update-embedding')
  @MultiPart()
  Future<void> updateFaceEmbedding(
    @Part(name: 'profile_id') String profileId,
    @Part(name: 'image') File image,
  );

  /// Device Security Endpoints

  @POST('/security/verify-device')
  Future<DeviceSecurityResponse> verifyDeviceSecurity(
    @Body() DeviceSecurityRequest request,
  );

  @POST('/security/register-device')
  Future<void> registerDevice(
    @Body() DeviceRegistrationRequest request,
  );

  @POST('/security/validate-binding')
  Future<DeviceBindingResponse> validateDeviceBinding(
    @Body() DeviceBindingRequest request,
  );

  @POST('/security/check-mock-location')
  Future<MockLocationResponse> checkMockLocation(
    @Body() MockLocationRequest request,
  );

  /// Reports & Analytics Endpoints

  @GET('/reports/payroll')
  @DioResponseType(ResponseType.bytes)
  Future<List<int>> generatePayrollReport(
    @Query('profile_id') String? profileId,
    @Query('start_date') String startDate,
    @Query('end_date') String endDate,
  );

  @GET('/reports/attendance-summary')
  Future<AttendanceSummaryResponse> getAttendanceSummary(
    @Query('profile_id') String? profileId,
    @Query('start_date') String startDate,
    @Query('end_date') String endDate,
  );
}

// ==================== REQUEST MODELS ====================

class DeviceSecurityRequest {
  final String deviceId;
  final String deviceModel;
  final String osVersion;
  final String platform;
  final Map<String, dynamic> securityChecks;

  DeviceSecurityRequest({
    required this.deviceId,
    required this.deviceModel,
    required this.osVersion,
    required this.platform,
    required this.securityChecks,
  });

  Map<String, dynamic> toJson() => {
        'device_id': deviceId,
        'device_model': deviceModel,
        'os_version': osVersion,
        'platform': platform,
        'security_checks': securityChecks,
      };
}

class DeviceRegistrationRequest {
  final String profileId;
  final String deviceId;
  final Map<String, dynamic> deviceInfo;

  DeviceRegistrationRequest({
    required this.profileId,
    required this.deviceId,
    required this.deviceInfo,
  });

  Map<String, dynamic> toJson() => {
        'profile_id': profileId,
        'device_id': deviceId,
        'device_info': deviceInfo,
      };
}

class DeviceBindingRequest {
  final String profileId;
  final String deviceId;

  DeviceBindingRequest({
    required this.profileId,
    required this.deviceId,
  });

  Map<String, dynamic> toJson() => {
        'profile_id': profileId,
        'device_id': deviceId,
      };
}

class MockLocationRequest {
  final double latitude;
  final double longitude;
  final Map<String, dynamic> locationMetadata;

  MockLocationRequest({
    required this.latitude,
    required this.longitude,
    required this.locationMetadata,
  });

  Map<String, dynamic> toJson() => {
        'latitude': latitude,
        'longitude': longitude,
        'location_metadata': locationMetadata,
      };
}

// ==================== RESPONSE MODELS ====================

class FaceVerificationResponse {
  final bool isMatch;
  final double confidence;
  final bool isLive;
  final double livenessScore;
  final String? message;

  FaceVerificationResponse({
    required this.isMatch,
    required this.confidence,
    required this.isLive,
    required this.livenessScore,
    this.message,
  });

  factory FaceVerificationResponse.fromJson(Map<String, dynamic> json) =>
      FaceVerificationResponse(
        isMatch: json['is_match'] as bool,
        confidence: (json['confidence'] as num).toDouble(),
        isLive: json['is_live'] as bool,
        livenessScore: (json['liveness_score'] as num).toDouble(),
        message: json['message'] as String?,
      );
}

class LivenessResponse {
  final bool isLive;
  final double score;
  final Map<String, dynamic>? details;

  LivenessResponse({
    required this.isLive,
    required this.score,
    this.details,
  });

  factory LivenessResponse.fromJson(Map<String, dynamic> json) =>
      LivenessResponse(
        isLive: json['is_live'] as bool,
        score: (json['score'] as num).toDouble(),
        details: json['details'] as Map<String, dynamic>?,
      );
}

class DeviceSecurityResponse {
  final bool isSecure;
  final List<String> violations;
  final String deviceId;
  final Map<String, dynamic> deviceInfo;

  DeviceSecurityResponse({
    required this.isSecure,
    required this.violations,
    required this.deviceId,
    required this.deviceInfo,
  });

  factory DeviceSecurityResponse.fromJson(Map<String, dynamic> json) =>
      DeviceSecurityResponse(
        isSecure: json['is_secure'] as bool,
        violations: (json['violations'] as List<dynamic>).cast<String>(),
        deviceId: json['device_id'] as String,
        deviceInfo: json['device_info'] as Map<String, dynamic>,
      );
}

class DeviceBindingResponse {
  final bool isValid;
  final String? message;

  DeviceBindingResponse({
    required this.isValid,
    this.message,
  });

  factory DeviceBindingResponse.fromJson(Map<String, dynamic> json) =>
      DeviceBindingResponse(
        isValid: json['is_valid'] as bool,
        message: json['message'] as String?,
      );
}

class MockLocationResponse {
  final bool isMock;
  final double confidence;
  final List<String>? indicators;

  MockLocationResponse({
    required this.isMock,
    required this.confidence,
    this.indicators,
  });

  factory MockLocationResponse.fromJson(Map<String, dynamic> json) =>
      MockLocationResponse(
        isMock: json['is_mock'] as bool,
        confidence: (json['confidence'] as num).toDouble(),
        indicators: (json['indicators'] as List<dynamic>?)?.cast<String>(),
      );
}

class AttendanceSummaryResponse {
  final int totalDays;
  final int presentDays;
  final int absentDays;
  final int lateDays;
  final int halfDays;
  final double attendancePercentage;
  final Map<String, dynamic> additionalStats;

  AttendanceSummaryResponse({
    required this.totalDays,
    required this.presentDays,
    required this.absentDays,
    required this.lateDays,
    required this.halfDays,
    required this.attendancePercentage,
    required this.additionalStats,
  });

  factory AttendanceSummaryResponse.fromJson(Map<String, dynamic> json) =>
      AttendanceSummaryResponse(
        totalDays: json['total_days'] as int,
        presentDays: json['present_days'] as int,
        absentDays: json['absent_days'] as int,
        lateDays: json['late_days'] as int,
        halfDays: json['half_days'] as int,
        attendancePercentage:
            (json['attendance_percentage'] as num).toDouble(),
        additionalStats: json['additional_stats'] as Map<String, dynamic>,
      );
}
